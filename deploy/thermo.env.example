# Device clouds
SALUS_EMAIL=
SALUS_PASSWORD=
TUYA_API_KEY=
TUYA_API_SECRET=
TUYA_USER_ID=
TUYA_REGION=eu

# Public origin, used to render invite links
PUBLIC_BASE_URL=https://example.com
# Contact address embedded in VAPID push claims (RFC 8292)
VAPID_SUBJECT=mailto:you@example.com
# Optional ntfy topic for service-level alerts; pick something unguessable
NTFY_TOPIC=

# Alert thresholds
ALERT_COLD_C=8
ALERT_HOT_C=30
ALERT_STUCK_HOURS=6
ALERT_SILENT_MINUTES=90
