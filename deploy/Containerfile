FROM docker.io/library/python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# pyit500 is installed straight from git.
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends git \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements-web.txt .
RUN pip install --no-cache-dir -r requirements-web.txt

# The web app reuses the existing fetchers rather than reimplementing the
# quirks of two device clouds, so they ship alongside it.
COPY log_temp.py read_temp.py tuya_temp.py devices.json ./
COPY thermo ./thermo

# Readings database, VAPID key, and the Tuya token cache.
RUN useradd --system --uid 10003 --no-create-home appuser \
 && mkdir -p /data && chown 10003:10003 /data
VOLUME /data
ENV DATA_DIR=/data

USER 10003
EXPOSE 8000
CMD ["uvicorn", "thermo.app:app", "--host", "0.0.0.0", "--port", "8000", \
     "--log-level", "info"]
